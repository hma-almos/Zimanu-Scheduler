                    <input type="number" class="form-control m-3" id="time" placeholder="كم عدد ساعات الدوام؟" value="@time">

                    <button type="button" class="btn btn-primary col-12 buttton1" onclick="addRow('dataTableBody1')">Add Row</button>
                    @* <button type="button" class="btn btn-primary" onclick="addRow()">Add Row</button> *@
                    @* <button type="button" class="btn btn-success" onclick="submitData()">Submit</button> *@
                    @* <div class="tablecontainer overflow-auto border p-3"> *@
