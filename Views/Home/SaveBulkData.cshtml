@using WebApplication5.dto;
@{
    ViewData["Title"] = "Bulk Insert";
    SaveBulkDataRequest saveBulkDataRequest = ViewBag.Data;
    List<Lecture> les = new List<Lecture>();
    List<Teacher> teachers = new List<Teacher>();
    int lab = 0;
    int room = 0;
    int time = 0;
    if (saveBulkDataRequest != null)
    {
        if (saveBulkDataRequest.Subjects.Any())
            les = saveBulkDataRequest.Subjects;

        if (saveBulkDataRequest.Teachers.Any())
            teachers = saveBulkDataRequest.Teachers;

        if (saveBulkDataRequest.Rooms.Any())
        {
            lab = saveBulkDataRequest.Rooms.Where(lab => lab.Type == "LAB").Count();
            room = saveBulkDataRequest.Rooms.Where(room => room.Type == "ROOM").Count();
        }

        if (saveBulkDataRequest.Time.Any())
            time = saveBulkDataRequest.Time.Count();
    }
}
