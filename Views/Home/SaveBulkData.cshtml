<script>
    function addRow(tableId) {
        var tableBody = document.getElementById(tableId);
        var rowCount = tableBody.rows.length + 1; // Get current count

        if (tableId === "dataTableBody1") {
            var newRow = `
                <tr>
                    <td class="row-number">${rowCount}</td>
                    <td><input type="text" class="custom-input w-100" placeholder="Enter teacher"></td>
                </tr>`;
        } else if (tableId === "dataTableBody2") {
            var newRow = `
                <tr>
                    <td class="row-number">${rowCount}</td>
                    <td><input type="text" class="custom-input w-100" placeholder="Enter subject"></td>
                    <td><input type="number" class="custom-input w-100" placeholder="how many hours"></td>
                    <td><input type="number" class="custom-input w-100" placeholder="Enter stage"></td>
                    <td><input type="number" class="custom-input w-100" placeholder="Room num"></td>
                </tr>`;
        }

        tableBody.insertAdjacentHTML("beforeend", newRow);

        // Auto-scroll to the bottom when a new row is added
        let tableContainer = tableBody.closest(".tablecontainer");
        tableContainer.scrollTop = tableContainer.scrollHeight;
    }

       function submitData() {
            let table1 = document.getElementById("dataTableBody1");
            let table2 = document.getElementById("dataTableBody2");
            let labs=document.getElementById("labs")
            let room=document.getElementById("rooms")
            let time=document.getElementById("time")

        // Create data objects from table data
        let data1 = getTableData(table1, ["Name"]);
        let data2 = getTableData(table2, ["Name","hours", "stages", "room"]);
            data2.forEach(item => {
        item.room = item.room && item.room.trim() !== "" ? item.room : "-1";
    });


        let stages = [], rooms = [], hours = [];
        let maxStage = Math.max(...data2.map(item => Number(item.stages)));
        let totalRooms = Number(room.value);
        let totalLabs = Number(labs.value);
        let totalHours = Number(time.value);


        let maxIterations = Math.max(maxStage, totalRooms, totalLabs, totalHours);

        for (let i = 1; i <= maxIterations; i++) {
            if (i <= maxStage) {
                stages.push({ name: `stage : ${i}` });
            }
            if (i <= totalRooms) {
                rooms.push({ name: i.toString(), type: "ROOM" });
            }
            if (i <= totalLabs) {
                rooms.push({ name: i.toString(), type: "LAB" });
            }
            if (i <= totalHours) {
                hours.push({ Hours: i });
            }
        }
        console.log("Table 1 Data:", data1);
        console.log("Table 2 Data:", data2);

        // The object to send in the POST request
        let payload = {
            Teachers: data1,  // Array of teacher objects
            Subjects: data2,   // Array of subject objects
            stages: stages,
            rooms:  rooms,
            time:  hours
        };
        console.log("payload:", payload);
                fetch('/Home/SaveBulkData', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
    })
    .then(response => response.json()) // Parse response as JSON
    .then(data => {
        if (data.redirectUrl) {
            window.location.href = data.redirectUrl;  // Redirect manually
        } else {
            alert("Data saved successfully!");
        }
    })
    .catch(error => console.error("Error:", error));
        }

        function getTableData(table, columns) {
        let rows = table.getElementsByTagName("tr");
        let data = [];

        for (let i = 0; i < rows.length; i++) {
            let inputs = rows[i].getElementsByTagName("input");
            let rowData = {};
            let isEmpty = true; // Flag to check if the row is empty

            columns.forEach((col, index) => {
                let value = inputs[index] ? inputs[index].value.trim() : "";
                rowData[col] = value;
                if (value !== "") isEmpty = false; // If any value is non-empty, mark as not empty
            });

            if (!isEmpty) {
                data.push(rowData);
            }
        }

        return data;
    }
</script>